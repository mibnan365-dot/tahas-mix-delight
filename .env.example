# Store API
PORT=8000
DATABASE_PATH=./taha-store.sqlite3

# Set both values to create or promote the store owner account at startup.
# Use a unique password of at least 14 characters.
TAHA_ADMIN_EMAIL=
TAHA_ADMIN_PASSWORD=

# Set a unique, randomly generated secret in production.
SESSION_SECRET=

# Keep the local origin in development. Replace with the HTTPS site origin in production.
PUBLIC_ORIGIN=
ALLOWED_ORIGIN=http://localhost:5173
